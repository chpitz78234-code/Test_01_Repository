{
  "$comment": "Maschinenlesbare Stil- und Animationsvorgabe. Frames beziehen sich auf fps_master, Pixel auf 1080x1920. 'source': measured = an Referenz-Frames gemessen, derived = abgeleitete Empfehlung. Ausführliche Beschreibung: STIL_UND_ANIMATIONSVORGABE.md",
  "version": "1.0.0",
  "global": {
    "format": { "aspect": "9:16", "width": 1080, "height": 1920, "reference_width": 720, "reference_height": 1280 },
    "fps_master": 30,
    "safe_area_px": { "top": 180, "bottom": 320, "left": 60, "right": 60 },
    "cut": {
      "default_transition": "hard_cut",
      "allow_crossfade": false,
      "snap_to_beat_tolerance_frames": 1,
      "scene_cut_lead_frames_max": 2,
      "no_repeat_background_color": true,
      "neutral_reset_colors": ["#FDFDFD", "#121212"]
    },
    "stagger": { "between_elements_frames": [2, 3], "order": ["mask_or_background", "title", "highlight_box", "main_sticker", "small_ornaments"], "offsets_frames": [0, 0, 8, 9, 16] },
    "endcard": { "duration_frames": [95, 127], "static_after_entry": true }
  },
  "easing": {
    "snap_out":    { "bezier": [0.20, 0.20, 0.05, 1.00], "source": "measured", "evidence": "Video 2, Titel-Scale f51-68" },
    "counter_out": { "bezier": [0.00, 0.00, 0.00, 1.00], "source": "measured", "evidence": "Video 3, Saldo-Zaehler f70-82" },
    "expo_out":    { "bezier": [0.16, 1.00, 0.30, 1.00], "source": "derived", "evidence": "Energieabfall nach Schnitten (Video 2/3)" },
    "whip_in":     { "bezier": [0.70, 0.00, 0.84, 0.00], "source": "derived", "evidence": "Video 3, Energie steigt 2-4x vor Schnitt" },
    "back_out":    { "bezier": [0.34, 1.56, 0.64, 1.00], "source": "derived", "max_overshoot": 0.08 },
    "soft_inout":  { "bezier": [0.45, 0.00, 0.55, 1.00], "source": "derived", "evidence": "Video 1" },
    "linear":      { "bezier": [0.00, 0.00, 1.00, 1.00], "source": "measured", "evidence": "Video 2, f210-243 konstante Energie" },
    "speed_ramp":  { "segments": [ { "share": 0.3, "easing": "expo_out" }, { "share": 0.4, "easing": "linear" }, { "share": 0.3, "easing": "whip_in" } ], "source": "measured", "evidence": "Video 3, f113-142" }
  },
  "durations_frames": {
    "micro": 2, "pop": 6, "wipe": [6, 8], "reveal": [7, 8], "title": 17,
    "flash_C": 15, "flash_D": 5, "shot_short_D": [13, 18], "shot_hold_D": 30, "scene_C": 61,
    "endcard": [95, 127]
  },
